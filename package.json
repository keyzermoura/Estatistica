{
  "name": "valida-metodo",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema web de validação de métodos analíticos com delineamento amostral estatístico",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "setup": "node scripts/setup.mjs",
    "start": "vite --open"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "docx": "^9.5.1",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.15.0",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^2.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "esbuild": "^0.25.0",
    "tinypool": "^2.2.0"
  }
}
